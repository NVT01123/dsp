    {
      "name": "xelatex",
      "command": "C:/Users/NVT/AppData/Local/Programs/MiKTeX/miktex/bin/x64/xelatex.exe",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ],
      "env": {}
    },
    {
      "name": "bibtex",
      "command": "C:/Users/NVT/AppData/Local/Programs/MiKTeX/miktex/bin/x64/bibtex.exe",
      "args": [
        "%DOCFILE%"
      ],
      "env": {}
    }
